  @@unique([tip, surum])
  @@index([tip, aktif])
  @@map("sozlesme_versiyonlari")
}

// CEKIRDEK: bildirim gonderim kayitlari (Faz 1 - tek kapi bildirim)
enum BildirimKanal {
  SMS
  EPOSTA
}

enum BildirimDurum {
  GONDERILDI
  HATA
}

model BildirimKayit {
  id         String        @id @default(uuid()) @db.Uuid
  kanal      BildirimKanal
  alici      String // telefon ya da e-posta
  sablonKodu String
  icerik     String
  durum      BildirimDurum
  hataMesaji String?
  createdAt  DateTime      @default(now())

  @@index([alici])
  @@index([sablonKodu])
  @@index([createdAt])
  @@map("bildirim_kayitlari")
}

// CEKIRDEK: is kuyrugu (Faz 1 - DB tabanli hafif kuyruk; BullMQ'ya gecis kapisi acik)
enum KuyrukDurum {
  BEKLIYOR
  ISLENIYOR
  TAMAM
  HATA
}

model IsKuyrugu {
  id             String      @id @default(uuid()) @db.Uuid
  tip            String // or. BILDIRIM_SMS
  payload        Json
  durum          KuyrukDurum @default(BEKLIYOR)
  denemeSayisi   Int         @default(0)
  maxDeneme      Int         @default(3)
  sonHata        String?
  calistirZamani DateTime    @default(now()) // bu zamandan once islenmez (retry gecikmesi)

  // ISI ISLERKEN HANGI DIKEYIN YUKUNE DOKUNULUYOR — tuketen taraf, ureten
  // taraf DEGIL. SIGORTA_LEAD_OLUSTUR'u LOAD dogurur ama isi yapan
  // SigortaService'tir ve yazma sigorta_talepleri'ne gider; o yuzden SIGORTA.
  // BILDIRIM_SMS'in tuketeni dikey-ustu altyapidir: PLATFORM.
  //
  // NULLABLE ve @default YOK — Cart.businessUnit'teki bilincli desen: dikey her
  // yaratmada acikca verilsin, unutulan yer derlenmesin. Zorunlu hale getirmek
  // ekle()'nin imzasini degistirmeyi gerektiriyor; o ayri pakette yapilacak.
  //
  // DIKKAT: bu kolon NULL kalan bir satiri, dikey filtreli bir worker ASLA
  // almaz (SQL'de NULL IN (...) false) - is sonsuza kadar BEKLIYOR'da kalir.
  // Bu yuzden backfill migration'i NULL kalan satir birakmiyor.
  businessUnit BusinessUnit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([durum, calistirZamani])
  @@index([tip])
  // Dikey filtreli isleyicinin tarayacagi yol (KuyrukService.sahiplen).
  @@index([businessUnit, durum, calistirZamani])
  @@map("is_kuyrugu")
}

// ============ EVDEN EVE (tasarim belgesi v1, 21 Tmz 2026) ============
// Kural 4: hicbir islem kesif olmadan kesinlesmez - EvTeklif durum makinesi bunu tasir.
// DIS baglar duz ID (holding ilkesi: baska dikeyin tablosuna FK/join yok):
//   tasitanId / tasiyanId -> User'a FK YOK, bilerek boyle.
// IC baglar FK'lidir: EvIlani <-> EvTeklif ayni dikeyin icindedir, holding ilkesi
//   burada gecerli degil; FK'siz birakmak yalnizca oksuz kayit uretirdi.

enum EvIlaniDurum {
  ODEME_BEKLIYOR // ilan ucreti havale + admin onayi bekliyor
  ACIK // yayinda, on teklif alabilir
  KESIF_SURECINDE // bir teklif kesfe davet edildi
  KILITLENDI // kesin fiyat kabul edildi, is baglandi
  TAMAMLANDI
  IPTAL
}

enum EvTeklifDurum {
  ON_TEKLIF // fotografa gore, baglayici degil
  KESFE_DAVET // tasitan bu teklifi secti, kesif randevusu dogdu
  KESIF_UYGUN // tasiyan evi gordu: beyan uygun, on teklif gecerli
  KESIF_REVIZE // tasiyan evi gordu: fark var, kesin fiyat revize
  KABUL // tasitan kesin fiyati kabul etti (kilit ani - iki sozlesme)
  RED
  GERI_CEKILDI
}

model EvIlani {
  id                  String       @id @default(uuid()) @db.Uuid
  tasitanId           String       @db.Uuid // duz ID (User'a FK yok)
  durum               EvIlaniDurum @default(ODEME_BEKLIYOR)
  evTipi              String // 1+1 ... 4+2
  neredenIl           String
  neredenIlce         String?
  neredenKat          Int?
  neredenAsansor      Boolean      @default(false)
  nereyeIl            String
  nereyeIlce          String?
  nereyeKat           Int?
  nereyeAsansor       Boolean      @default(false)
  alimTarihi          DateTime
  teslimBaslangic     DateTime? // esnek teslim penceresi - TASIYAN belirler (kesif/teklif asamasi), tasitan girmez
  teslimBitis         DateTime?
  fotograflar         Json // kamera-zorunlu cekimler (Kural 3) - [{url, cekimZamani}]
  aciklama            String?
  sigortaTalebi       Boolean      @default(false) // Kural 6 - BaniSigorta lead
  ilanUcretiKurus     BigInt? // dusuk pesin ucret (havale + admin onay)
  ucretDekont         String? // tasitanin havale dekont/aciklamasi
  ucretBildirimZamani DateTime? // tasitan 'havaleyi yaptim' dedigi an
  ucretOnayZamani     DateTime? // admin onayi -> ACIK
  seciliTeklif        EvTeklif?    @relation("SeciliEvTeklif", fields: [seciliTeklifId], references: [id])
  seciliTeklifId      String?      @unique @db.Uuid
  teklifler           EvTeklif[]   @relation("EvIlanTeklifleri")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([durum, alimTarihi])
  @@index([tasitanId])
  @@index([neredenIl, nereyeIl])
  @@map("ev_ilanlari")
}

model EvTeklif {
  id               String        @id @default(uuid()) @db.Uuid
  // Restrict: teklif is delilidir (kabulTarihi/kabulIp, kesif fotograflari).
  // Teklif almis ilan silinemez - yuk/arac tarafiyla ayni kural.
  evIlani          EvIlani       @relation("EvIlanTeklifleri", fields: [evIlaniId], references: [id], onDelete: Restrict)
  evIlaniId        String        @db.Uuid
  seciliOlan       EvIlani?      @relation("SeciliEvTeklif")
  tasiyanId        String        @db.Uuid // duz ID
  durum            EvTeklifDurum @default(ON_TEKLIF)
  onTeklifKurus    BigInt // fotografa gore on teklif
  kesifRandevu     DateTime? // KESFE_DAVET aninda belirlenir
  kesifZamani      DateTime? // tasiyanin kesif sonucunu girdigi an
  kesinFiyatKurus  BigInt? // KESIF_UYGUN ise onTeklif kopyalanir; KESIF_REVIZE ise yeni fiyat
  kesifFotograflar Json? // tasiyanin kamera-zorunlu kesif cekimleri (iki tarafli delil)
  kesifNotu        String?
  kabulTarihi      DateTime?
  kabulIp          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([evIlaniId, durum])
  @@index([tasiyanId])
  @@map("ev_teklifleri")
}

// EVDEN EVE: donus-yuku ilani (A-mini: vitrin + davet; is mantigi yok, zincir ev ilaninda akar)
enum DonusYukuDurum {
  AKTIF
  PASIF
}

model DonusYukuIlani {
  id        String         @id @default(uuid()) @db.Uuid
  tasiyanId String         @db.Uuid // duz ID
  durum     DonusYukuDurum @default(AKTIF)
  neredenIl String
  nereyeIl  String
  tarihBas  DateTime // musaitlik penceresi
  tarihBit  DateTime
  aracTipi  String?
  aciklama  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([durum, tarihBas])
  @@index([neredenIl, nereyeIl])
  @@map("donus_yuku_ilanlari")
}

// BULTEN: e-posta abone kaydi (vitrin footer'larindaki bulten formu)
// businessUnit enum DEGIL String: CARSI / MARKET / LOAD / GENEL ...
// Ayni e-posta farkli dikeylere ayri ayri abone olabilir.
model NewsletterSubscriber {
  id           String   @id @default(uuid()) @db.Uuid
  eposta       String
  businessUnit String   @default("GENEL")
  createdAt    DateTime @default(now())

  @@unique([eposta, businessUnit])
  @@index([businessUnit])
  @@map("newsletter_subscribers")
}

// ===================== FAZ 4 — ENVANTER =====================
//
// STOK ARTIK SATIR: Product.stock / ProductVariant.stock kolonlari F4'te
// DUSURULECEK (A1'deki users.roles deseni - duran kolon sessiz ikinci kaynak
// olurdu). F1'de tablolar ADDITIVE geliyor, okuma yolu HALA eski kolonlar;
// davranis F2'de degisecek.
//
// MIKTARLAR Int (kaynak belgedeki decimal'den BILINCLI SAPMA): sistemin kendi
// kurali "stok EN KUCUK BIRIMDE TAM SAYIDIR" (bkz. Product.unitType yorumu) ve
// siparis hattindaki BigInt(quantity) carpimlarinin tamami buna dayaniyor.
// Decimal'e gecmek tek tabloyla sinirli kalmaz, siparis hattinin tamamini kapsar.

enum MovementType {
  SATIS
  IADE
  GIRIS
  TRANSFER
  SAYIM
  FIRE
  DUZELTME
}

/// Urun/varyant basina STOK BAKIYESI. Kaynak tablo (F2'den itibaren).
model InventoryBalance {
  id String @id @default(uuid()) @db.Uuid

  // store_id BILEREK YOK: Product zaten storeId tasiyor (@@unique([storeId, slug])).
  // Ikinci kopya "urun A magazasinda ama bakiyesi B magazasinda" gibi imkansiz bir
  // durumu yazilabilir kilardi - C'de kapatilan "ayni soruya iki cevap" kalibi.
  // Magaza bazli sorgu JOIN products ile cozulur; hareket tablosunda ise store_id
  // DURUYOR cunku orasi snapshot/denetim kaydi.
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // NULL = urun duzeyi stok. Bugunku ProductVariant.stock = NULL semantiginin
  // aynisi; boylece etkinStok'un iki dali da tek tabloya iner ve F4'te
  // ProductVariant.stock da dusurulebilir.
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  availableQuantity Int @default(0) // satilabilir
  reservedQuantity  Int @default(0) // FAZ 4'TE HEP 0: gercek rezervasyon akisi (BR-004/005) Faz 5'e ertelendi
  damagedQuantity   Int @default(0) // fire

  reorderLevel      Int @default(0) // siparis verme esigi
  lowStockThreshold Int @default(0) // dusuk stok esigi (yalniz GORUNURLUK ucu; bildirim Faz 8)

  // OPTIMISTIC LOCK — YALNIZ MIKTAR DISI ALANLAR ICIN (reorderLevel,
  // lowStockThreshold, damagedQuantity duzenlemeleri). Miktar dususu kosullu
  // yazimla korunur (WHERE availableQuantity >= q); version'i oraya da kosul
  // koymak iki esszamanli satisi birbirini gereksiz yere reddettirirdi.
  version Int @default(0)

  updatedAt DateTime @updatedAt

  // NULLABLE UNIQUE UYARISI: variantId NULL iken Postgres'te NULL != NULL, yani
  // ayni urune teorik olarak iki "urun duzeyi" satiri yazilabilir. user_roles'ta
  // kabul edilen ayni bilincli borc: yazma TEK KAPIDAN gececek (F2), kismi
  // unique indeks Prisma semasinda ifade edilemedigi icin her migrate diff'te
  // drift uretirdi.
  @@unique([productId, variantId])
  @@index([productId])
  @@map("inventory_balances")
}

/// STOK HAREKETI — denetim kaydi. Bakiye uzerine yazilir, hareket ASLA silinmez.
model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid

  // SNAPSHOT: hareketin o anda HANGI magazada oldugu. Urun ileride devredilse
  // bile gecmis hareket degismemeli - OrderItem.name/unitPrice ile ayni gerekce.
  // Bu yuzden bakiye tablosunun aksine burada store_id DURUYOR.
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  type MovementType

  // ISARETLI: satis -5, giris +5. Ayri bir "yon" kolonu tip<->yon tutarsizligi
  // riski dogururdu (SATIS + pozitif gibi); SUM(quantity) = net degisim.
  quantity  Int
  beforeQty Int // hareket oncesi availableQuantity
  afterQty  Int // hareket sonrasi availableQuantity

  reason String? // fire nedeni, duzeltme gerekcesi

  // Hangi kayittan dogdu: 'ORDER' | 'ORDER_CANCEL' | 'COUNT' | ...
  // FK YOK (OrderItem.variantId ile ayni gerekce): kaynak kayit silinse de
  // hareket okunabilir kalmali.
  referenceType String?
  referenceId   String? @db.Uuid

  actorId String? @db.Uuid
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // RESTRICT (Cascade DEGIL): hareket DELILDIR, deger tasir. Turetilmis erisim
  // kayitlarinda (store_users, user_roles) Cascade tercih edilmisti; burasi
  // wallets/deliveries.courierId sinifinda.
  @@index([productId, createdAt])
  @@index([storeId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}
