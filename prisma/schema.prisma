generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== RBAC — 12 ROL =====================
enum Role {
  CUSTOMER
  COURIER
  MERCHANT
  RESTAURANT
  MARKET_OPERATOR
  COFFEE_BRANCH
  DICLEFUL_OPERATOR
  DICLEFUL_DRIVER
  LOAD_CUSTOMER
  CARRIER
  ADMIN
  SUPER_ADMIN

  // Faz 1 / C2 — ILK VE SIMDILIK TEK MAGAZA KAPSAMLI ROL.
  // Yalnizca user_roles.storeId DOLU iken yazilir; kapsam kurali icin bkz.
  // model UserRole -> storeId yorumu. C2'de hicbir izne baglanmadi
  // (role_permissions'a satir eklenmedi): C1'den sonra magaza kapsamli roller
  // AuthUser.roles'a girmiyor, dolayisiyla PermissionsGuard onlarin iznini
  // zaten cozemez - izin vermek bugun anlamsiz olurdu. Magaza kapsamli izin
  // cozumlemesi Faz 1/B'nin isi.
  STORE_STAFF

  // Faz 1 / B1 — MAGAZA KADROSU. Uceu de yalnizca storeId DOLU yazilir.
  // STORE_STAFF genel personel rolu olarak IZINSIZ kalir; asagidaki uc rol
  // kendi izinleriyle gelir. Izinleri role_permissions'ta yasar ama guard'da
  // KODDAKI beyaz listeyle kesisime girer (bkz. permissions.guard.ts) - panelden
  // yanlislikla verilen bir platform izni magaza rolunden gecemesin diye.
  STORE_KITCHEN // mutfak: siparis hazirlama
  STORE_CASHIER // kasa: siparis/odeme
  STORE_STOCK // depo: stok ve urun yazma
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  phone         String     @unique
  phoneVerified Boolean    @default(false)
  email         String?    @unique
  name          String?
  surname       String?
  passwordHash  String?
  // roles KOLONU KALDIRILDI (Faz 1 / A1) -> user_roles tablosu.
  // Bkz. model UserRole: rol artik satirdir, cunku C adiminda magaza kapsami
  // (storeId) tasiyacak ve enum dizisi kolonuna kapsam konamaz.
  // Kolon BILEREK birakilmadi: duran bir kolon sessiz ikinci kaynak olurdu
  // (isAdmin'in iki dosyada ayrismasinin aynisi). Dusurulunce her okuma
  // noktasi DERLEME HATASI verir - tsc kacan yolu deploydan once yakalar.
  status        UserStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  otpRequests      OtpRequest[]
  refreshTokens    RefreshToken[]
  transferCodes    TransferCode[]
  addresses        Address[]
  wallets          Wallet[]
  socialIdentities SocialIdentity[]
  ownedStores      Store[]
  saticiKayitlari  Seller[]         @relation("SellerOwner")
  magazaUyelikleri StoreUser[] // personel olarak calistigi magazalar
  rolAtamalari     UserRole[]
  carts            Cart[] // dikey basina bir sepet
  orders           Order[]
  deliveries       Delivery[]       @relation("CourierDeliveries")

  verdigiYukler           YukIlani[]          @relation("VerdigiYukler")
  aracIlanlari            AracIlani[]         @relation("AracIlanlari")
  verdigiTeklifler        YukTeklif[]         @relation("VerdigiTeklifler")
  verdigiAracTeklifleri   AracTeklif[]        @relation("VerdigiAracTeklifleri")
  komisyonOdemeleri       KomisyonOdeme[]     @relation("KomisyonOdemeleri")
  sozlesmeOnaylari        SozlesmeOnay[]      @relation("SozlesmeOnaylari")
  loadFirmaProfil         LoadFirmaProfil?
  loadTasiyiciProfil      LoadTasiyiciProfil?
  loadBelgeler            LoadBelge[]
  loadPuan                LoadPuan?
  verdigiDegerlendirmeler LoadDegerlendirme[] @relation("VerdigiDegerlendirmeler")
  aldigiDegerlendirmeler  LoadDegerlendirme[] @relation("AldigiDegerlendirmeler")
  stokHareketleri         InventoryMovement[]

  // @@index([phone]) KALDIRILDI: phone zaten @unique - users_phone_key ayni isi goruyor
  @@map("users")
}

model SocialIdentity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
  @@map("social_identities")
}

// ===================== AUTH — OTP + Oturum =====================
enum OtpPurpose {
  LOGIN
  PHONE_VERIFICATION
  PASSWORD_RESET
}

model OtpRequest {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int        @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  userId     String?    @db.Uuid
  user       User?      @relation(fields: [userId], references: [id])

  @@index([phone, createdAt])
  @@map("otp_requests")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// CROSS-DOMAIN OTURUM DEVRI: kullanici markali domainler arasinda gecerken
// (banigroup.com.tr -> banikervan.com.tr) oturumu tasiyan KISA OMURLU,
// TEK KULLANIMLIK bilet. Kod URL'de tasindigi icin uzun omurlu bir sir
// (refresh token) ASLA URL'e konmaz; bunun yerine bu bilet tuketilince
// hedef domain icin TAZE access+refresh uretilir.
//
// Konvansiyon OtpRequest/RefreshToken ile ayni: ham deger degil HASH saklanir,
// tuketim consumedAt ile damgalanir.
model TransferCode {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kodHash     String    @unique // sha256(ham kod) - RefreshToken.tokenHash deseni
  hedefOrigin String // kod YALNIZCA bu origin icin gecerli; baska siteye tasinamaz
  consumedAt  DateTime? // tek kullanimlik damgasi (OtpRequest.consumedAt deseni)
  expiresAt   DateTime // 60 sn TTL - URL'de gorunen bir degerin omru kisa olmali
  ip          String?
  cihaz       String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt]) // suresi gecmis kayitlarin toplanmasi icin
  @@map("transfer_codes")
}

// ===================== ADRES =====================
enum AddressType {
  HOME
  WORK
  BILLING
  OTHER
}

model Address {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AddressType @default(HOME)
  title        String?
  fullName     String?
  phone        String?
  country      String      @default("TR")
  city         String
  district     String?
  neighborhood String?
  line1        String
  line2        String?
  postalCode   String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@index([userId])
  @@map("addresses")
}

// ===================== FİNANS (double-entry) =====================
enum Currency {
  TRY
  USD
  EUR
}

enum WalletType {
  USER
  MERCHANT
  PLATFORM
  ESCROW
}

model Wallet {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String?       @db.Uuid
  // Restrict: cuzdani olan kullanici HARD DELETE edilemez. Eskiden SetNull idi ve
  // bakiyeli cuzdan sahipsiz kaliyordu: userId NULL olunca getOrCreateUserWallet
  // (userId ile arar) onu bir daha bulamaz, @@unique([userId,type,currency]) de
  // NULL satirlari kapsamaz (Postgres'te NULL != NULL) - para sessizce kaybolurdu.
  // userId nullable KALIR: sistem cuzdanlarinda (PLATFORM/ESCROW) userId NULL'dir.
  user         User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  type         WalletType    @default(USER)
  businessUnit BusinessUnit? // birim defteri (Faz 1'de zorunlulasir)
  currency     Currency      @default(TRY)
  balance      BigInt        @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  entries LedgerEntry[]

  @@unique([userId, type, currency])
  @@map("wallets")
}

enum TransactionType {
  TOPUP
  WITHDRAWAL
  TRANSFER
  PAYMENT
  REFUND
  FEE
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum BusinessUnit {
  MARKET
  YEMEK
  CARSI
  COFFEE
  LOAD
  DICLEFUL
  COURIER
  PLATFORM // cekirdek/holding defteri (cuzdan ops: topup/withdrawal/transfer)

  // BaniSigorta. Sistemde dikey olarak zaten vardi (sigorta_talepleri,
  // sigorta_sube_basvurulari, SigortaModule) ama BusinessUnit onu tanimiyordu.
  // is_kuyrugu.businessUnit ile birlikte eklendi: SIGORTA_LEAD_OLUSTUR isinin
  // TUKETEN tarafi Sigorta'dir, PLATFORM degil.
  SIGORTA
}

model Transaction {
  id           String            @id @default(uuid()) @db.Uuid
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  currency     Currency          @default(TRY)
  amount       BigInt
  orderNo      String?
  businessUnit BusinessUnit
  commission   BigInt            @default(0)
  vat          BigInt            @default(0)
  deliveryFee  BigInt            @default(0)
  netRevenue   BigInt            @default(0)
  reference    String?           @unique
  description  String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  entries LedgerEntry[]

  deletedAt DateTime?

  @@index([type, status])
  @@index([businessUnit])
  @@index([orderNo])
  @@map("transactions")
}

enum EntryDirection {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id            String         @id @default(uuid()) @db.Uuid
  transactionId String         @db.Uuid
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  walletId      String         @db.Uuid
  wallet        Wallet         @relation(fields: [walletId], references: [id])
  direction     EntryDirection
  amount        BigInt
  balanceAfter  BigInt
  createdAt     DateTime       @default(now())

  @@index([walletId])
  @@index([transactionId])
  @@map("ledger_entries")
}

// ===================== DENETİM =====================
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===================== FAZ 2 — MARKET / KATALOG / SEPET =====================
enum StoreType {
  MARKET
  RESTAURANT
  CAFE
  SHOP
}

// ===================== FAZ 2 — SATICI (SELLER) =====================
enum SellerType {
  RESTORAN
  MARKET
  URETICI
  LOJISTIK
  HIZMET
}

// DRAFT -> UNDER_REVIEW -> ACTIVE            (askiya alinip geri acilabilir)
//            |                \
//            v                 v
//         NEEDS_FIX          SUSPENDED
// Hepsinden CLOSED'a gidilir; CLOSED'dan donus YOKTUR.
enum SellerStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  NEEDS_FIX
  SUSPENDED
  CLOSED
}

enum SellerVerification {
  EKSIK
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
  SURESI_DOLDU
}

// SATICI: magazanin arkasindaki ticari kimlik.
//
// SAHIPLIK TASINMADI: stores.ownerId yerinde kalir. Satici hakedisi bugun
// delivery.service icinde order.store.ownerId cuzdanina yaziliyor; sahipligi
// buraya tasimak canlida para dagitan tek transaction'a dokunmak demekti.
// Seller EK bir katmandir: ticari kimlik, dogrulama ve durum burada yasar.
model Seller {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @db.Uuid // hukuki sahip; backfill'de Store.ownerId ile ayni kisi
  owner       User   @relation("SellerOwner", fields: [ownerUserId], references: [id])

  sellerType  SellerType
  legalName   String // ticari unvan
  displayName String // platformda gorunen ad

  // VERGI KIMLIGI SIFRELI SAKLANIR (AES-256-GCM, uygulama katmani).
  // Kolonda duz metin DEGIL, "v1:iv:tag:ciphertext" bicimli sifreli blob durur;
  // anahtar yalnizca ortam degiskeninde (bkz. common/crypto/gizli-alan.ts).
  // pgcrypto yerine uygulama katmani secildi: anahtar SQL metnine gomulmez,
  // dolayisiyla sorgu logu / query cache uzerinden sizamaz.
  taxIdentifier String? // sifreli blob
  taxLast4      String? // ekranda gosterim icin maskesiz son 4 hane

  status                SellerStatus       @default(DRAFT)
  verification          SellerVerification @default(EKSIK)
  // "Suresi Doldu" bir DURUM degil SONUCTUR: belge onaylanir + bitis tarihi
  // yazilir, tarih gecince kayit gecersizlesir. Enum'a tek basina yazilsaydi
  // tarihi gecmis oldugu halde ONAYLANDI kalan kayitlar olurdu.
  verificationExpiresAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stores   Store[]
  belgeler SaticiBelge[]

  @@index([ownerUserId])
  @@index([status])
  @@map("sellers")
}

// SATICI KYC BELGELERI — load_belgeleri (LoadBelge) deseninin satici karsiligi.
//
// AYRI ENUM, ORTAK DEGIL: LoadBelgeTipi tasimaciliga ozgu (EHLIYET, SRC,
// K_BELGE, ARAC_RUHSAT) ve satici icin anlamsiz. Ortak enum, iki tarafin
// listesini birbirine kilitler; her yeni satici belgesi Load ekranlarinda da
// belirirdi.
//
// VERGI NO ICIN AYRI DOGRULAMA ALANI ACILMADI: satici tarafinda "vergi no
// dogrulandi" durumu, VERGI_LEVHASI belgesinin admin tarafindan ONAYLANDI'ya
// alinmasidir - canli bir GIB cagrisi degil. Kural BaniLoad'da zaten boyle
// isliyor. Sonuc Seller.verification'a yazilir, ikinci bir alan tutulmaz.
enum SaticiBelgeTipi {
  VERGI_LEVHASI
  IMZA_SIRKULERI
  TICARET_SICIL_GAZETESI
  FAALIYET_BELGESI
  KIMLIK
  IBAN_BELGESI
  DIGER
}

enum SaticiBelgeDurum {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
}

model SaticiBelge {
  id         String           @id @default(uuid()) @db.Uuid
  seller     Seller           @relation(fields: [sellerId], references: [id])
  sellerId   String           @db.Uuid
  tip        SaticiBelgeTipi
  dosyaUrl   String
  durum      SaticiBelgeDurum @default(BEKLIYOR)
  redGerekce String?
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([sellerId])
  // Admin inceleme kuyrugu BEKLIYOR uzerinden sorgulanir (B1'deki desen).
  @@index([durum])
  @@map("satici_belgeleri")
}

// BOLGE: Merkez -> Bolge -> Alt bolge (kendine referansli).
//
// Bolge neden Store DEGIL: market.service.listActive musteriye donuk vitrin
// listesidir ve tum aktif magazalari dondurur; bolgeyi Store satiri yapmak
// bolgeleri musteri vitrininde magaza gibi listelerdi. Bolgenin katalogu,
// siparisi, personeli de yoktur.
model Region {
  id       String   @id @default(uuid()) @db.Uuid
  parentId String?  @db.Uuid
  parent   Region?  @relation("RegionTree", fields: [parentId], references: [id])
  children Region[] @relation("RegionTree")
  name     String
  code     String   @unique
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]

  @@index([parentId])
  @@map("regions")
}

// MAGAZA CALISMA SAATLERI. BR-014'un veri kaynagi.
// KAYIT YOKSA MAGAZA ACIK SAYILIR - aksi halde bu tablo eklendigi an canli
// 5 magazanin hepsi kapanirdi (hicbirinde saat kaydi yok).
model StoreHour {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  weekday   Int      @db.SmallInt // 0=Pazar ... 6=Cumartesi (JS getDay ile ayni)
  openTime  DateTime @db.Time(0) // string degil TIME: karsilastirma ve saat dogrulugu
  closeTime DateTime @db.Time(0)
  isClosed  Boolean  @default(false) // o gun tamamen kapali

  effectiveFrom  DateTime  @db.Date
  effectiveUntil DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, weekday, effectiveFrom])
  @@index([storeId])
  @@map("store_hours")
}

model Store {
  id             String       @id @default(uuid()) @db.Uuid
  ownerId        String       @db.Uuid
  owner          User         @relation(fields: [ownerId], references: [id])
  // Ticari kimlik. Backfill sonrasi ZORUNLU; her magaza bir saticiya aittir.
  sellerId       String       @db.Uuid
  seller         Seller       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  // SUBE: sube ayri bir tablo DEGIL, parentId ile isaretlenen bir Store'dur.
  // Ayri Branch tablosu StoreUser/Category/Product/Cart/Order'a ikinci bir
  // boyut (branchId) sokardi; parentId ile mevcut her sorgu degismeden calisir.
  parentId       String?      @db.Uuid
  parent         Store?       @relation("StoreTree", fields: [parentId], references: [id], onDelete: Restrict)
  subeler        Store[]      @relation("StoreTree")
  regionId       String?      @db.Uuid
  region         Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  name           String
  slug           String       @unique
  type           StoreType    @default(MARKET)
  businessUnit   BusinessUnit @default(MARKET)
  description    String?
  logoUrl        String?
  phone          String?
  city           String?
  district       String?
  line1          String?
  latitude       Float?
  longitude      Float?
  commissionRate Int          @default(1000) // binde (1000 = %10)
  minOrder       BigInt       @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  categories      Category[]
  products        Product[]
  secenekGruplari OptionGroup[]
  orders          Order[]
  personel        StoreUser[]
  rolAtamalari    UserRole[]
  calismaSaati    StoreHour[]
  stokHareketleri InventoryMovement[]

  @@index([ownerId])
  @@index([sellerId])
  @@index([parentId])
  @@index([type, isActive])
  @@map("stores")
}

// MAGAZA PERSONELI — operasyonel erisim.
//
// Magazaya erisim bugune kadar TEK kaynaktan geliyordu: stores.ownerId. Bu yuzden
// MARKET_OPERATOR / RESTAURANT / COFFEE_BRANCH rolleri ORDER_MANAGE iznini tasiyip
// hicbir siparise erisemiyordu (sahibi olmadiklari magazada 403).
//
// SAHIPLIK BURAYA TASINMADI: stores.ownerId hukuki/finansal sahip olarak KALIR -
// teslimat tamamlaninca satici hakedisi onun cuzdanina yaziliyor
// (delivery.service: getOrCreateUserWallet(order.store.ownerId)). Sahipligi coklu
// bir tabloya dagitmak "bu paranin sahibi kim" sorusunu belirsizlestirirdi.
//
// UYELIK YETKI DEGIL KAPSAM verir: kullanicinin rolundeki izinleri O MAGAZADA
// kullanilabilir kilar, yeni izin eklemez.
// ROL ATAMASI ARTIK SATIR — Faz 1 / A1.
//
// Eskiden users.roles bir Postgres enum DIZISIYDI. Kapsam (hangi magazada
// gecerli) bir dizi kolonuna yazilamaz; C adiminda gelecek "mutfak personeli
// SADECE su subede" kurali bu tablonun storeId'sinde yasayacak.
//
// A1'DE DAVRANIS DEGISMIYOR: storeId HER SATIRDA NULL yaziliyor (= platform
// geneli), yani bugunku dizi davranisinin birebir aynisi. Kolon simdiden
// aciliyor ki C adimi sema degil yalnizca kod degisikligi olsun.
//
// ROL KIMLIGI HALA `Role` ENUM'I: 27 kod referansi ve @Roles(...) dekoratoru
// derleme zamani guvenligini buradan aliyor. Serbest metne cevirmek o guvenligi
// tumuyle yok ederdi. Yeni rol eklemek tek satirlik migration
// (ALTER TYPE "Role" ADD VALUE ...), B adiminda oyle yapilacak.
model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role

  // NULL = platform geneli. A1'de tum satirlar boyle.
  // Cascade: magaza silinince o magazaya kapsanmis rol anlamsizdir (StoreUser
  // ile ayni gerekce - turetilmis erisim kaydi, deger/delil tasimaz).
  //
  // KAPSAM KURALI (Faz 1 / C2): STORE_STAFF yalniz storeId DOLU yazilir; diger
  // 12 rol yalniz NULL. Bu kural DB'de degil, tek yazma kapisinda zorlanir -
  // Prisma CHECK ve kismi unique indeksi semada ifade edemedigi icin DB kisiti
  // kalici drift uretirdi (ayni gerekceyle kismi unique indeks de reddedilmisti,
  // bkz. asagidaki nullable-unique notu). Bilincli kabul edilmis borctur.
  storeId String? @db.Uuid
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // DIKKAT — NULLABLE UNIQUE: storeId NULL iken Postgres'te NULL != NULL, yani
  // ayni rol teorik olarak iki kez yazilabilir. cart_items'taki ayni desen.
  // Burada zarar YETKI DEGIL GORUNTU: okuma tarafi Set ile tekillestiriyor,
  // izin kumesi degismiyor. Yazma zaten tek kapidan (users.assignRoles: sil+yaz,
  // tek transaction). Kismi unique index yine tercih edilmedi - Prisma semasinda
  // ifade edilemedigi icin her migrate diff'te drift uretirdi.
  @@unique([userId, role, storeId])
  @@index([userId]) // her istekte okunan yol: JwtStrategy.validate
  @@index([storeId])
  @@map("user_roles")
}

// FAZ 1 / A2 — IZIN MATRISI ARTIK VERI.
// Permission ENUM OLARAK KALIYOR (Role gibi): 59 uctaki @RequirePermissions(...)
// derleme zamani guvenligini oradan aliyor. Bu tablo enum degerlerini SATIR olarak
// tutar; ikisinin ayrismadigini test dogrular (yeni enum degeri tabloya da girmeli).
model Permission {
  key         String  @id // 'store:write' - Permission enum'inin DEGERI
  description String? // panelde gosterilecek aciklama (A2/adim 2)

  createdAt DateTime @default(now())

  rolAtamalari RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String     @id @default(uuid()) @db.Uuid
  role          Role
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([role, permissionKey])
  @@index([role]) // her istekte okunan yol: PermissionsGuard -> IzinMatrisi
  @@map("role_permissions")
}

model StoreUser {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Isten ayrilan personel SILINMEZ, kapatilir: gecmis audit kayitlari "bu kisi
  // o sirada uyeydi" baglamini korumali.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cascade (iki tarafta da): uyelik turetilmis erisim kaydidir, deger/delil
  // tasimaz - magaza ya da kullanici yoksa anlamsizdir. Deger tasiyan baglarda
  // (wallets, deliveries.courierId) Restrict tercih edilmisti; burasi o sinifta degil.
  @@unique([storeId, userId]) // bir kisi bir magazada tek uyelik
  @@index([userId]) // "bu kullanicinin magazalari": bilesik unique'in oneki storeId
  @@map("store_users")
}

// ===================== FAZ 3 — KATALOG: VARYANT / SECENEK / MEDYA =====================
enum ProductType {
  FIZIKSEL
  YEMEK
  HIZMET
  MENU
}

enum UnitType {
  ADET
  GRAM
  KILOGRAM
  LITRE
  MILILITRE
  PORSIYON
}

// Siparis satirinin akibeti: eksik cikan ya da muadille degistirilen kalem.
// ALAN SIMDI EKLENIYOR: sonradan eklemek gecmis siparisleri siniflandirilamaz
// birakirdi. Davranis (otomatik iade) kismi iade altyapisi gelince baglanacak.
enum OrderItemStatus {
  NORMAL
  EKSIK
  IKAME
}

// VARYANT: boy/porsiyon/renk. Fiyat ve stok varyanttaysa oradan, YOKSA urunden
// okunur (null = "urunun degeri gecerli"). Boylece mevcut varyantsiz urunler
// hicbir sey degismeden calismaya devam eder.
model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sku       String?
  barcode   String?

  price BigInt? // null -> product.price
  stock Int? // null -> product.stock

  // Carsi muhasebe kirilimi varyant bazinda gerekirse; null ise urunun degeri.
  netFiyat        BigInt?
  komisyonTutari  BigInt?
  kargoTutari     BigInt?
  malKdvTutari    BigInt?
  hizmetKdvTutari BigInt?

  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  envanter        InventoryBalance[]
  stokHareketleri InventoryMovement[]
  cartItems       CartItem[]

  @@unique([productId, name])
  @@index([productId, isActive])
  @@map("product_variants")
}

// SECENEK GRUBU MAGAZAYA AIT: "Ekstra malzeme" grubu bir kez tanimlanip
// birden cok urune baglanir (Banitemek menu deseni).
model OptionGroup {
  id        String  @id @default(uuid()) @db.Uuid
  storeId   String  @db.Uuid
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  minSecim  Int     @default(0)
  maxSecim  Int     @default(1)
  zorunlu   Boolean @default(false)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options Option[]
  urunler ProductOptionGroup[]

  @@index([storeId])
  @@map("option_groups")
}

model Option {
  id            String      @id @default(uuid()) @db.Uuid
  optionGroupId String      @db.Uuid
  group         OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name          String
  // CARSI'DA NET (satici payi); musteriye gosterilecek tutar
  // ekUcretHesapla(...).vitrinKurus'tan gelir, DOGRUDAN OKUNMAZ. Aksi halde
  // musteri satici netini gorup vitrin ucretini oder. Sepet bu cevrimi
  // yapiyor (cart.secimleriCoz); vitrin okuma ucu de AYNI fonksiyonu
  // cagirmali - ikinci bir fiyat formulu yazilmaz.
  // Carsi disi dikeylerde ekUcret dogrudan satis tutaridir.
  ekUcret       BigInt      @default(0) // kurus
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([optionGroupId])
  @@map("options")
}

model ProductOptionGroup {
  productId     String      @db.Uuid
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroupId String      @db.Uuid
  group         OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)

  @@id([productId, optionGroupId])
  @@index([optionGroupId])
  @@map("product_option_groups")
}

// COKLU MEDYA. Product.imageUrl KALDI (kapak gorseli): tum vitrin okumalari ona
// bakiyor, kaldirmak bu adimi gereksiz buyuturdu. Backfill'de her imageUrl
// buraya birincil medya olarak kopyalanir; tek kaynaga indirme sonraki fazda.
model ProductMedia {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  tur       String  @default("GORSEL") // GORSEL | VIDEO | BELGE
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_media")
}

// MUADIL: TEK YONLU ve oncelikli. Hedef urun Restrict - muadil olarak gosterilen
// urun sessizce silinemez.
model ProductSubstitution {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @db.Uuid
  product      Product @relation("MuadilKaynak", fields: [productId], references: [id], onDelete: Cascade)
  substituteId String  @db.Uuid
  substitute   Product @relation("MuadilHedef", fields: [substituteId], references: [id], onDelete: Restrict)
  oncelik      Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([productId, substituteId])
  @@index([productId, oncelik])
  @@map("product_substitutions")
}

// Sepete tasinan secimler (secim anindaki ek ucret ANLIK KOPYA).
model CartItemOption {
  id         String   @id @default(uuid()) @db.Uuid
  cartItemId String   @db.Uuid
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  optionId   String   @db.Uuid
  optionAdi  String
  // MUSTERININ ODEDIGI ek ucret. Carsi'da bu, Option.ekUcret'in (satici neti)
  // uzerine komisyon + KDV eklenmis halidir; Carsi disinda Option.ekUcret'in
  // aynisi.
  ekUcret    BigInt   @default(0)

  // CARSI MUHASEBE KIRILIMI — ek ucret de tam fiyat hattindan gecer.
  // NULL = Carsi disi (kirilim yok), urun/varyant tarafiyla ayni desen.
  // Kargo kalemi YOK: kargo gonderi basinadir ve urun fiyatinin icinde zaten
  // var; her ekstra malzemeye taban tarife (120,61 TL) eklenemez. Yuvarlama da
  // yok - yuvarlama farkini yazacak kargo kalemi olmadigi icin. Boylece
  // ekUcret == netFiyat + komisyon + malKdv + hizmetKdv BIREBIR tutar ve
  // checkout'un "dagitim == subtotal" guvencesi bozulmaz.
  netFiyat        BigInt?
  komisyonTutari  BigInt?
  malKdvTutari    BigInt?
  hizmetKdvTutari BigInt?

  createdAt DateTime @default(now())

  @@unique([cartItemId, optionId])
  @@map("cart_item_options")
}

// Siparis satirindaki secim SNAPSHOT'i: Option silinse de kayit bozulmaz,
// bu yuzden optionId'ye FK YOK, ad ve ucret kopyalanir (OrderItem deseni).
model OrderItemOption {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionId    String?   @db.Uuid
  optionAdi   String
  ekUcret     BigInt    @default(0)

  @@index([orderItemId])
  @@map("order_item_options")
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  storeId   String     @db.Uuid
  // Restrict: katalogu olan magaza silinemez. Cascade iken magaza silmek kategoriyi
  // ve urunleri sessizce yok ediyordu; kapatma yolu soft delete (deletedAt).
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  name      String
  slug      String
  parentId  String?    @db.Uuid
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentId]) // iki seviyeli agac: alt basliklar parentId ile cekiliyor
  @@map("categories")
}

model Product {
  id              String    @id @default(uuid()) @db.Uuid
  storeId         String    @db.Uuid
  // Restrict: kategori tarafiyla ayni gerekce - urun fiyat/KDV/komisyon tasir,
  // magaza silinerek sessizce yok edilemez. Urun icin soft delete zaten var.
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  categoryId      String?   @db.Uuid
  category        Category? @relation(fields: [categoryId], references: [id])
  name            String
  slug            String
  description     String?
  sku             String?
  imageUrl        String?
  price           BigInt // kuruş (minor units)
  currency        Currency  @default(TRY)
  stock           Int       @default(0)
  unit            String?   @default("adet")
  desi            Float     @default(0) // kargo: hacimsel ağırlık (desi)
  weightKg        Float     @default(0) // kargo: fiili ağırlık (kg)
  komisyonTutari  BigInt    @default(0) // muhasebe: komisyon (kuruş) = net × %15
  kargoTutari     BigInt    @default(0) // muhasebe: gömülü kargo + yuvarlama (kuruş)
  malKdvTutari    BigInt    @default(0) // muhasebe: satıcı KDV'si = net × kategori oranı
  hizmetKdvTutari BigInt    @default(0) // muhasebe: platform KDV'si = (komisyon+kargo) × %20
  netFiyat        BigInt    @default(0) // satıcının girdiği net fiyat (kuruş)
  kdvOrani        Int       @default(20) // ürün KDV oranı: 1 / 10 / 20
  satisModeli     String    @default("A") // A=kendi ürün, B=dropshipping

  // ===== FAZ 3 — KATALOG =====
  barcode                String? // GTIN/EAN. Merkezi katalog eslesmesinin anahtari olacak.
  shortDescription       String?
  productType            ProductType @default(FIZIKSEL)
  // TARTILI URUN KURALI: quantity/stock EN KUCUK BIRIMDE TAM SAYIDIR.
  // 750 g -> quantity 750, price = GRAM basina kurus. unitType neyin sayildigini
  // soyler. Paranin kuruşta tutulmasiyla ayni desen: ondalik hic girmiyor, bu
  // sayede orders.service'teki BigInt(quantity) carpimlarinin hicbiri degismedi.
  unitType               UnitType    @default(ADET)
  minimumQuantity        Int? // tartilida en az satis miktari (or. 100 g)
  quantityStep           Int? // tartilida artis adimi
  preparationTimeMinutes Int? // Banitemek: hazirlama suresi
  // MERKEZI KATALOG icin YER AYRILDI — FK YOK, cunku MasterProduct tablosu
  // henuz yok. Tablo gelince FK eklenecek; simdi FK koymak olmayan bir tabloya
  // baglanmak olurdu.
  masterProductId        String?     @db.Uuid

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cartItems       CartItem[]
  varyantlar      ProductVariant[]
  medya           ProductMedia[]
  secenekGruplari ProductOptionGroup[]
  envanter        InventoryBalance[]
  stokHareketleri InventoryMovement[]
  muadilleri      ProductSubstitution[] @relation("MuadilKaynak")
  muadiliOldugu   ProductSubstitution[] @relation("MuadilHedef")

  @@unique([storeId, slug])
  @@index([storeId, isActive])
  @@index([categoryId])
  @@index([barcode])
  @@index([masterProductId])
  @@map("products")
}

model Cart {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Sepet DIKEYE kilitli: kullanicinin her dikeyde ayri sepeti olur. Bilerek
  // @default YOK - dikey her yaratmada acikca verilsin, unutulan yer derlenmesin.
  businessUnit BusinessUnit
  storeId      String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  items CartItem[]

  // userId onek oldugu icin "kullanicinin sepetleri" sorgusu da bu indeksi kullanir.
  @@unique([userId, businessUnit])
  @@map("carts")
}

model CartItem {
  id        String          @id @default(uuid()) @db.Uuid
  cartId    String          @db.Uuid
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id])
  // Varyant OPSIYONEL: null = varyantsiz urun (bugunku tum kayitlar boyle).
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  // TAM SAYI MIKTAR: adet urunde adet, tartilida en kucuk birim (gram/ml).
  quantity  Int             @default(1)
  unitPrice BigInt // ürünün sepete eklendiği andaki fiyatı (kuruş)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  secimler CartItemOption[]

  // TEKILLIK ARTIK DB'DE DEGIL, UYGULAMADA — Faz 3 / adim 3 karari.
  //
  // Ayni urun+varyant, FARKLI SECIM KUMESI = AYRI KALEM (ayranli ve ayransiz
  // ayni doner iki satirdir). Tekillik anahtari artik secim kumesini de
  // kapsiyor; secimler ayri tabloda (cart_item_options) durdugu icin bu, ne
  // @@unique ile ne de kismi indeksle ifade edilebilir. Eski
  // @@unique([cartId, productId, variantId]) tam da bu ikinci kalemi P2002 ile
  // reddediyordu, o yuzden DUSURULDU (bkz. 20260820140000_faz3_sepet_secenekleri).
  //
  // Yerine gecen koruma: cart.service.addItem adaylari okuyup secim kumesini
  // karsilastiriyor. BEDELI BILINEREK ALINDI: es zamanli iki istek ayni kalemi
  // iki satir yazabilir (miktar birlesmez, para yanlis olmaz).
  //
  // Asagidaki indeks o aday aramasinin (+ cartId onekiyle sepet okumasinin)
  // indeksidir; unique'in yerini alir.
  @@index([cartId, productId, variantId])
  @@index([productId]) // FK: Postgres otomatik indekslemez - urun bazli sorgu + FK dogrulamasi
  @@map("cart_items")
}

// ===================== FAZ 3 — SİPARİŞ / ÖDEME (ESCROW) =====================
enum OrderStatus {
  PENDING // oluşturuldu, ödeme bekliyor (kısa geçiş durumu)
  CONFIRMED // ödeme alındı, escrow'da tutuluyor; satıcı onayı bekliyor
  PREPARING // hazırlanıyor
  READY // hazır
  ON_THE_WAY // yolda
  DELIVERED // teslim edildi (escrow dağıtıldı)
  CANCELLED // iptal edildi (müşteriye iade)
  REFUNDED // iade edildi
}

enum PaymentStatus {
  PENDING
  PAID // müşteriden alındı, escrow'da
  RELEASED // satıcı + platforma dağıtıldı
  REFUNDED // müşteriye geri ödendi
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  orderNo       String        @unique
  userId        String        @db.Uuid
  user          User          @relation(fields: [userId], references: [id])
  storeId       String        @db.Uuid
  store         Store         @relation(fields: [storeId], references: [id])
  businessUnit  BusinessUnit  @default(MARKET)
  status        OrderStatus   @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PAID)

  subtotal    BigInt // mal toplamı (kuruş)
  deliveryFee BigInt @default(0)
  discount    BigInt @default(0)
  total       BigInt // müşterinin ödediği = subtotal + deliveryFee - discount
  commission  BigInt @default(0) // platform komisyonu
  vat         BigInt @default(0) // komisyon içindeki KDV (raporlama)
  netRevenue  BigInt @default(0) // satıcı hakedişi = subtotal - commission

  addressId    String?   @db.Uuid
  addressText  String?
  contactPhone String? // teslimat adresi anlık kopyası
  note         String?
  placedAt     DateTime  @default(now())
  confirmedAt  DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items    OrderItem[]
  delivery Delivery?

  @@index([userId])
  @@index([storeId, status])
  // @@index([orderNo]) KALDIRILDI: orderNo zaten @unique (Transaction.orderNo unique DEGIL, oradaki index kaliyor)
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String @db.Uuid
  name      String // anlık kopya
  unitPrice BigInt // anlık kopya (kuruş)
  quantity  Int
  lineTotal BigInt // unitPrice * quantity

  // VARYANT SNAPSHOT: ad kopyalanir, variantId'ye FK YOK - varyant silinse de
  // gecmis siparis okunabilir kalmali (OrderItem.name ile ayni gerekce).
  variantId  String?         @db.Uuid
  variantAdi String?
  // "750" neyin 750'si oldugu siparise de yazilir; urun sonradan degisse bile
  // gecmis satir kendi basina anlasilir kalir.
  unitType   UnitType        @default(ADET)
  status     OrderItemStatus @default(NORMAL)

  secimler OrderItemOption[]

  @@index([orderId])
  @@map("order_items")
}

// ===================== FAZ 4 — KURYE / TESLİMAT =====================
enum DeliveryStatus {
  PENDING // havuzda, kurye bekliyor
  ASSIGNED // kuryeye atandı
  PICKED_UP // kurye aldı, yolda
  DELIVERED // teslim edildi
  CANCELLED // iptal
}

enum DeliveryYontem {
  KENDI // DicleFul kendi kuryesi
  ARACI // dış kargo firması (MNG, Aras, ...)
}

enum KargoFirmasi {
  DICLEFUL
  MNG
  ARAS
  YURTICI
  PTT
  SURAT
  UPS
}

model Delivery {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @unique @db.Uuid
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierId    String?        @db.Uuid
  // Restrict: teslimati yapan kurye silinemez - "bu teslimati kim yapti" is delili.
  // SetNull olsaydi kurye silindiginde tamamlanmis teslimat sessizce sahipsiz kalirdi.
  // Kurye atamasi/kaldirilmasi UPDATE'tir, bu kisittan etkilenmez.
  courier      User?          @relation("CourierDeliveries", fields: [courierId], references: [id], onDelete: Restrict)
  status       DeliveryStatus @default(PENDING)
  fee          BigInt         @default(0) // kurye hakedişi (= order.deliveryFee)
  note         String?
  yontem       DeliveryYontem @default(KENDI) // kendi kuryesi mi, aracı kurum mu
  kargoFirmasi KargoFirmasi? // ARACI ise hangi firma
  takipNo      String?        @unique // aracı firmanın takip no'su (public takip anahtarı)

  // TESLIM KANITI — tek kullanimlik teslim kodu.
  // Siparis onaylandiginda uretilir, musteriye bildirilir (siparis ekrani birincil
  // kanal; contactPhone varsa SMS ikincil), kurye teslimat aninda girer.
  // deliver() bu kod dogrulanmadan DELIVERED yazmaz ve escrow dagitimi yapmaz.
  //
  // DUZ METIN saklanir (hash degil): musteri kodu her an tekrar gorebilmeli.
  // Siparislerin buyuk cogunlugu misafir ve telefonsuz oldugu icin "yalnizca
  // uretim aninda goster" pratikte kodu kaybettirirdi. Kod bir kimlik dogrulama
  // sirri degil, fiziksel teslimin ikinci teyididir; KURYE UCLARINDA DONMEZ.
  // unique DEGIL: 6 hanede cakisma normaldir, unique olsa uretim rastgele patlardi.
  teslimKod             String?
  teslimKodDogrulandiAt DateTime?
  teslimKodDeneme       Int       @default(0)

  assignedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deletedAt DateTime?

  @@index([courierId, status])
  @@index([status])
  @@map("deliveries")
}

// ============================================================
// BANİLOAD — Yuk/Arac Ilani + Teklif + Eslestirme (Faz 1)
// (Model/alan adlari Latin harfli Turkce; ekranda tam Turkce gosterilir)
// ============================================================

enum YukIlaniDurum {
  ACIK // ilan acik, teklif bekliyor
  TEKLIF_ALINDI // en az bir teklif geldi
  ESLESTI // teklif kabul edildi, tasiyici belli
  TASINIYOR // yuk yolda
  TAMAMLANDI // teslim edildi, komisyon islendi
  IPTAL // ilan iptal
}

enum AracTipi {
  TIR
  KAMYON
  KAMYONET
  TENTELI
  FRIGORIFIK
  KAPALI_KASA
  ACIK_KASA
  LOWBED
}

enum AracIlaniDurum {
  MUSAIT // bosta, yuk ariyor
  DOLU // bir ise atandi
  PASIF // tasiyici kapatti
  TAMAMLANDI // teslim onaylandi, is bitti (komisyon tahakkuk)
}

enum YukTeklifDurum {
  BEKLIYOR // yuk veren degerlendirsin
  KABUL // kabul edildi (ilan ESLESTI olur)
  RED // reddedildi / baska teklif kabul edildi
  GERI_CEKILDI // tasiyici teklifini cekti
}

enum TeklifTaraf {
  TASIYICI
  FIRMA
}

model YukIlani {
  id                String        @id @default(uuid()) @db.Uuid
  veren             User          @relation("VerdigiYukler", fields: [verenId], references: [id])
  verenId           String        @db.Uuid
  nereden           String // il/ilce (or. "Istanbul / Tuzla")
  nereye            String
  yukTipi           String // "Paletli Urun", "Tekstil", "Mobilya"...
  tonajKg           Int // kilogram cinsinden
  aracTipiIhtiyaci  AracTipi? // istenen arac tipi (opsiyonel)
  yuklemeTarihi     DateTime
  aciklama          String?
  butceKurus        BigInt? // yuk verenin tahmini butcesi (opsiyonel)
  durum             YukIlaniDurum @default(ACIK)
  seciliTeklif      YukTeklif?    @relation("SeciliTeklif", fields: [seciliTeklifId], references: [id])
  seciliTeklifId    String?       @unique @db.Uuid
  teklifler         YukTeklif[]   @relation("IlanTeklifleri")
  teslimBeyanTarihi DateTime? // kamyoncu 'teslim ettim' dedigi an
  teslimOnayTarihi  DateTime? // firma onayladigi an (= gercek teslim tarihi)
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // @@index([durum]) KALDIRILDI: [durum, yuklemeTarihi] bileşik index'inin oneki ayni isi goruyor
  @@index([verenId])
  @@index([durum, yuklemeTarihi])
  @@map("yuk_ilanlari")
}

model AracIlani {
  id                 String         @id @default(uuid()) @db.Uuid
  tasiyici           User           @relation("AracIlanlari", fields: [tasiyiciId], references: [id])
  tasiyiciId         String         @db.Uuid
  aracTipi           AracTipi
  nereden            String // cikis bolgesi
  nereye             String // gidecegi yon
  cikisTarihi        DateTime
  plaka              String?
  teslimBeyanTarihi  DateTime? // kamyoncu teslim beyani
  teslimOnayTarihi   DateTime? // firma onayi (= teslim tarihi)
  kapasiteKg         Int
  beklenenFiyatKurus BigInt? // tasiyicinin bekledigi navlun (opsiyonel)
  deletedAt          DateTime?
  aciklama           String?
  durum              AracIlaniDurum @default(MUSAIT)
  seciliTeklif       AracTeklif?    @relation("SeciliAracTeklif", fields: [seciliTeklifId], references: [id])
  seciliTeklifId     String?        @unique @db.Uuid
  teklifler          AracTeklif[]   @relation("AracIlanTeklifleri")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // @@index([durum]) KALDIRILDI: [durum, cikisTarihi] bileşik index'inin oneki ayni isi goruyor
  @@index([tasiyiciId])
  @@index([durum, cikisTarihi])
  @@map("arac_ilanlari")
}

model YukTeklif {
  id               String         @id @default(uuid()) @db.Uuid
  // Restrict: teklif is delilidir (kabulTarihi/kabulIp/kabulCihaz). Teklif almis ilan
  // silinemez - sessiz delil kaybi yerine gurultulu hata. Kapatma yolu: durum = IPTAL.
  yukIlani         YukIlani       @relation("IlanTeklifleri", fields: [yukIlaniId], references: [id], onDelete: Restrict)
  yukIlaniId       String         @db.Uuid
  tasiyici         User           @relation("VerdigiTeklifler", fields: [tasiyiciId], references: [id])
  tasiyiciId       String         @db.Uuid
  fiyatKurus       BigInt // tasiyicinin teklif ettigi tasima bedeli (kurus)
  plaka            String?
  surucuAdi        String?
  surucuTel        String?
  mesaj            String?
  // Is delili: teklif KABUL edildiginde damgalanir (B modeli - eslesme kaniti)
  kabulTarihi      DateTime?
  kabulIp          String?
  kabulCihaz       String?
  durum            YukTeklifDurum @default(BEKLIYOR)
  beklenenTaraf    TeklifTaraf    @default(TASIYICI) // pazarlik: kimin onayi bekleniyor
  elSayisi         Int            @default(0) // pazarlik el sayisi (3 sinirinda uyari)
  ilkTalepKurus    BigInt? // ilan verenin ilk talebi
  ilkTeklifKurus   BigInt? // teklif verenin ilk teklifi
  gerceklesenKurus BigInt? // anlasilan son tutar (kabul aninda)
  seciliOlan       YukIlani?      @relation("SeciliTeklif")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  deletedAt DateTime?

  @@index([yukIlaniId])
  @@index([tasiyiciId])
  @@map("yuk_teklifleri")
}

model AracTeklif {
  id               String         @id @default(uuid()) @db.Uuid
  // Restrict: yuk tarafiyla ayni gerekce - teklif almis arac ilani silinemez.
  aracIlani        AracIlani      @relation("AracIlanTeklifleri", fields: [aracIlaniId], references: [id], onDelete: Restrict)
  aracIlaniId      String         @db.Uuid
  veren            User           @relation("VerdigiAracTeklifleri", fields: [verenId], references: [id])
  verenId          String         @db.Uuid
  fiyatKurus       BigInt // firmanin teklif ettigi navlun (kurus)
  mesaj            String?
  kabulTarihi      DateTime?
  kabulIp          String?
  kabulCihaz       String?
  durum            YukTeklifDurum @default(BEKLIYOR)
  beklenenTaraf    TeklifTaraf    @default(TASIYICI) // kimin onayi bekleniyor
  elSayisi         Int            @default(0) // pazarlik el sayisi (3 sinirinda uyari)
  ilkTalepKurus    BigInt? // ilan verenin ilk talebi
  ilkTeklifKurus   BigInt? // teklif verenin ilk teklifi
  gerceklesenKurus BigInt? // anlasilan son tutar (kabul aninda)
  seciliOlan       AracIlani?     @relation("SeciliAracTeklif")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  deletedAt DateTime?

  @@index([aracIlaniId])
  @@index([verenId])
  @@map("arac_teklifleri")
}

// ============================================================
// BANİLOAD — Komisyon Odeme + Borc Takibi (Faz 1 tahsilat)
// Borc = (TAMAMLANDI tasimalarin %5 toplami) - (ONAYLANDI odemeler)
// ============================================================

enum KomisyonOdemeYontem {
  HAVALE // EFT/havale + admin onayi (su an aktif)
  KART // POS entegrasyonu sonrasi aktif olacak
}

enum KomisyonOdemeDurum {
  BEKLIYOR // havale bildirildi, admin onayi bekliyor
  ONAYLANDI // admin onayladi, borc dustu
  RED // reddedildi
}

model KomisyonOdeme {
  id          String              @id @default(uuid()) @db.Uuid
  tasiyici    User                @relation("KomisyonOdemeleri", fields: [tasiyiciId], references: [id])
  tasiyiciId  String              @db.Uuid
  tutarKurus  BigInt // odenen komisyon tutari (kurus)
  yontem      KomisyonOdemeYontem @default(HAVALE)
  durum       KomisyonOdemeDurum  @default(BEKLIYOR)
  dekont      String? // havale dekont/aciklama (kullanici girer)
  adminNot    String? // admin onay/red notu
  deletedAt   DateTime?
  onaylayanId String?             @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([tasiyiciId])
  @@index([durum])
  @@map("komisyon_odemeleri")
}

// ============================================================
// BANİLOAD — Sozlesme Onay (B modeli)
// Uyelikte TEK ONAY (kullanici basina bir kez, surum bazli).
// Her iste ayri sozlesme YOK; is delili YukTeklif'e gomulu.
// Metin GECICI taslak; avukat onayindan sonra surum guncellenir.
// ============================================================

enum SozlesmeTipi {
  TASIYICI // tasiyici (CARRIER) uyelik sozlesmesi
  YUK_VEREN // yuk veren (LOAD_CUSTOMER) uyelik sozlesmesi
  EVDEN_EVE_TASIYAN // evden eve: tasiyan sozlesmesi (kesif sonrasi kabul aninda)
  EVDEN_EVE_TASITAN // evden eve: tasitan sozlesmesi (kesif sonrasi kabul aninda)

  // SATICI TARAFI — ikiye AYRILDI, tek tip yapilmadi:
  // uyelik metni nadiren, komisyon sartlari sik degisir. Tek tip olsaydi her
  // komisyon orani degisikligi uyelik sozlesmesinin de yeniden onaylanmasini
  // gerektirirdi (SozlesmeVersiyon tip basina tek aktif surum tutar).
  SATICI // satici uyelik sozlesmesi
  SATICI_KOMISYON // satici komisyon sartlari (oran degisince yeni surum)
}

model SozlesmeOnay {
  id           String       @id @default(uuid()) @db.Uuid
  kullanici    User         @relation("SozlesmeOnaylari", fields: [kullaniciId], references: [id])
  kullaniciId  String       @db.Uuid
  sozlesmeTipi SozlesmeTipi
  surum        String // onaylanan metin surumu (or. "v1-taslak"); avukat degisince artar
  metinHash    String // onaylanan metnin SHA-256 hash'i (degismedi kaniti)
  ip           String? // onayin geldigi IP (kanit)
  cihaz        String? // user-agent / cihaz (kanit)
  onayTarihi   DateTime     @default(now())
  createdAt    DateTime     @default(now())

  // Her kullanici, her sozlesme tipinin her surumunu BIR KEZ onaylar
  @@unique([kullaniciId, sozlesmeTipi, surum])
  // @@index([kullaniciId]) KALDIRILDI: yukaridaki unique'in oneki ayni isi goruyor
  @@map("sozlesme_onaylari")
}

// ============================================================
//  PARTNER BASVURULARI — satici / franchise / restoran / kurye
//  Tek tablo, tip ayrimli. Tum alanlar opsiyonel (tipe gore dolar).
// ============================================================

enum PartnerBasvuruTip {
  SELLER // Carsi satici basvurusu
  FRANCHISE // Coffee franchise basvurusu
  RESTAURANT // Restoran (Yemek) basvurusu
  COURIER // Kurye basvurusu
  MARKET // Market basvurusu
  DICLEFUL // DicleFul kargo/fulfillment basvurusu
}

enum PartnerBasvuruDurum {
  BEKLIYOR // yeni geldi, incelenmedi
  INCELENDI // admin baktı
  ONAYLANDI // kabul edildi
  RED // reddedildi
}

model PartnerBasvuru {
  id    String              @id @default(uuid()) @db.Uuid
  tip   PartnerBasvuruTip
  durum PartnerBasvuruDurum @default(BEKLIYOR)

  // Ortak alanlar (tum formlarda var)
  adSoyad String
  telefon String
  il      String?

  // Tipe ozel alanlar (opsiyonel)
  isletme      String? // SELLER: isletme adi
  restoran     String? // RESTAURANT: restoran adi
  butce        String? // FRANCHISE: yatirim butcesi
  aracTipi     String? // COURIER: arac tipi (motor/bisiklet/araba - serbest)
  email        String? // DICLEFUL: teklif formundaki e-posta
  aylikAdet    String? // DICLEFUL: aylik siparis adedi (serbest metin - "500-1000" gibi yazilabiliyor)
  mesaj        String? // DICLEFUL: musterinin yazdigi talep metni
  businessUnit BusinessUnit? // SELLER icin CARSI vb.

  // Kanit / iletisim
  not   String? // admin notu
  ip    String?
  cihaz String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([tip])
  @@index([durum])
  @@map("partner_basvurulari")
}

