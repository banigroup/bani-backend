model LoadDegerlendirme {
  id          String   @id @default(uuid()) @db.Uuid
  puan        Int // 1-5 yildiz
  yorum       String? // simdilik kullanilmiyor, ileride
  // Restrict (eskiden Cascade): puan veren ya da alan kullanici silinemez.
  // Cascade UCUNCU TARAFI vuruyordu - A silinince A'nin B'ye verdigi puan satiri
  // yok oluyor, ama B'nin LoadPuan.ortalama/sayi degeri artimli tutuldugu icin
  // (load.service.ts) oldugu gibi kaliyordu: ozet hicbir gercek satira dayanmaz
  // hale geliyordu ve yeniden hesaplama yolu YOK.
  veren       User     @relation("VerdigiDegerlendirmeler", fields: [verenId], references: [id], onDelete: Restrict)
  verenId     String   @db.Uuid
  alan        User     @relation("AldigiDegerlendirmeler", fields: [alanId], references: [id], onDelete: Restrict)
  alanId      String   @db.Uuid
  verenRol    String // FIRMA | TASIYICI
  yukIlaniId  String?  @db.Uuid
  aracIlaniId String?  @db.Uuid
  evIlaniId   String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([verenId, yukIlaniId])
  @@unique([verenId, aracIlaniId])
  @@unique([verenId, evIlaniId])
  @@index([alanId])
  @@map("load_degerlendirmeler")
}

// Load-sahipli puan ozeti (Faz 0: I-2 kapanisi - cekirdek User birim verisi tasimaz)
model LoadPuan {
  userId     String @id @db.Uuid
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ortalama   Float  @default(0)
  sayi       Int    @default(0)
  evOrtalama Float  @default(0) // evden eve tasiyan puani - ayri (farkli is modeli)
  evSayi     Int    @default(0)

  @@map("load_puanlari")
}

